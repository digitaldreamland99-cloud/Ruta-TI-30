<Window x:Class="RutaTI30.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Ruta TI 30 — Preparación en Soporte TI"
        Height="780" Width="1240" MinHeight="640" MinWidth="1024"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource BgBrush}"
        FontFamily="Segoe UI">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="250" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Navegación lateral -->
        <Border Grid.Column="0" Background="{DynamicResource SidebarBrush}"
                BorderBrush="{DynamicResource BorderBrush2}" BorderThickness="0,0,1,0">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Margin="18,22,18,18">
                    <TextBlock Text="Ruta TI 30" Style="{StaticResource H1}" FontSize="22" />
                    <TextBlock Text="Soporte TI en 30 días" Style="{StaticResource Muted}" Margin="0,4,0,0" />
                    <Border Style="{StaticResource Badge}" Margin="0,12,0,0"
                            HorizontalAlignment="Left" Background="{DynamicResource AccentBrush}">
                        <TextBlock Text="Modo local · sin conexión" FontSize="11" FontWeight="SemiBold"
                                   Foreground="{DynamicResource OnAccentBrush}" />
                    </Border>
                </StackPanel>

                <ListBox x:Name="NavList"
                         Style="{StaticResource NavList}"
                         ItemsSource="{Binding NavItems}"
                         SelectedItem="{Binding SelectedNav, Mode=TwoWay}"
                         KeyboardNavigation.TabNavigation="Cycle">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Label}" FontSize="14" />
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <TextBlock DockPanel.Dock="Bottom" Style="{StaticResource Muted}"
                           Text="Versión 0.1.0 · datos en tu perfil de usuario"
                           Margin="18,12,18,16" />
            </DockPanel>
        </Border>

        <!-- Contenido -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource BorderBrush2}" BorderThickness="0,0,0,1"
                    Padding="24,16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding CurrentTitle}" Style="{StaticResource H2}" />
                    <TextBlock Grid.Column="1" Text="{Binding CurrentDate}" Style="{StaticResource Muted}"
                               VerticalAlignment="Center" />
                </Grid>
            </Border>

            <ContentControl Grid.Row="1" Content="{Binding CurrentViewModel}" Margin="24,18,24,0"
                            Focusable="False" />
        </Grid>
    </Grid>
</Window>

<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:vm="clr-namespace:RutaTI30.App.ViewModels">

    <!-- ===================== RUTA DE APRENDIZAJE ===================== -->
    <DataTemplate DataType="{x:Type vm:LearnViewModel}">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Lista de días -->
            <Border Grid.Column="0" Style="{StaticResource Card}" Padding="10" VerticalAlignment="Stretch">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="30 días" Style="{StaticResource H3}" Margin="8,6,8,10" />
                    <ListBox Style="{StaticResource PlainList}" ItemsSource="{Binding Days}"
                             SelectedItem="{Binding SelectedDay}"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             VirtualizingPanel.IsVirtualizing="True">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="2,3">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding Day, StringFormat='Día {0}'}" FontWeight="SemiBold"
                                                   FontSize="13" Margin="0,0,8,0" />
                                        <TextBlock Text="{Binding StateLabel}" FontSize="11"
                                                   Foreground="{DynamicResource AccentBrush}" />
                                    </StackPanel>
                                    <TextBlock Text="{Binding Title}" Style="{StaticResource Muted}" FontSize="12" />
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>

            <!-- Detalle de la lección -->
            <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto" Padding="0,0,8,20">
                <StackPanel>
                    <TextBlock Text="Selecciona un día para ver su lección" Style="{StaticResource Muted}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Visible" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasLesson}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <StackPanel Visibility="{Binding HasLesson, Converter={StaticResource BoolToVis}}">
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding LessonTitle}" Style="{StaticResource H2}" />
                                    <!-- Estado con color semántico + texto nominal (idéntico al patrón del dashboard) -->
                                    <Border Style="{StaticResource Badge}" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding LessonStateText}" FontSize="12" FontWeight="SemiBold">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock" BasedOn="{StaticResource BadgeText}">
                                                    <Setter Property="Foreground" Value="{DynamicResource MutedBrush}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding LessonStateText}" Value="En curso">
                                                            <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding LessonStateText}" Value="Completado">
                                                            <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding LessonStateText}" Value="Dominado">
                                                            <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Border>
                                </StackPanel>
                                <TextBlock Text="{Binding LessonMeta}" Style="{StaticResource Muted}" Margin="0,6,0,0" />
                                <TextBlock Text="{Binding LastScoreText}" Style="{StaticResource Muted}" />
                                <TextBlock Text="{Binding LessonObjective}" Style="{StaticResource H3}" Margin="0,12,0,0" />
                                <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                                    <Button Content="Marcar en curso" Style="{StaticResource BtnSecondary}"
                                            Command="{Binding StartLessonCommand}" />
                                    <Button Content="Marcar completada" Style="{StaticResource BtnSecondary}"
                                            Command="{Binding CompleteLessonCommand}" />
                                    <Button Content="Presentar evaluación" Style="{StaticResource BtnPrimary}"
                                            Command="{Binding ToggleEvaluationCommand}" />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- Evaluación -->
                        <Border Style="{StaticResource MsgInfo}" Visibility="{Binding EvaluationVisible, Converter={StaticResource BoolToVis}}">
                            <StackPanel>
                                <TextBlock Text="Evaluación de la lección" Style="{StaticResource H3}" />
                                <TextBlock Style="{StaticResource Muted}" Margin="0,4,0,10"
                                           Text="Responde y envía para obtener tu puntaje con soluciones explicadas. Puedes repetirla: el historial se conserva." />
                                <ItemsControl ItemsSource="{Binding Questions}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="{DynamicResource SurfaceAltBrush}" CornerRadius="8"
                                                    Padding="14" Margin="0,0,0,10">
                                                <StackPanel>
                                                    <TextBlock Text="{Binding Statement}" Style="{StaticResource Body}"
                                                               FontWeight="SemiBold" TextWrapping="Wrap" />
                                                    <ListBox ItemsSource="{Binding Options}" SelectedItem="{Binding Selected}"
                                                             Background="Transparent" BorderThickness="0" Margin="0,8,0,0"
                                                             Padding="0">
                                                        <ListBox.ItemContainerStyle>
                                                            <Style TargetType="ListBoxItem">
                                                                <Setter Property="Template">
                                                                    <Setter.Value>
                                                                        <ControlTemplate TargetType="ListBoxItem">
                                                                            <Border x:Name="bd" Background="Transparent"
                                                                                    BorderBrush="{DynamicResource BorderBrush2}"
                                                                                    BorderThickness="1"
                                                                                    CornerRadius="6" Padding="10,7" Margin="0,0,0,6">
                                                                                <ContentPresenter />
                                                                            </Border>
                                                                            <ControlTemplate.Triggers>
                                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                                    <Setter TargetName="bd" Property="Background" Value="{DynamicResource SurfaceAltBrush}" />
                                                                                </Trigger>
                                                                                <Trigger Property="IsSelected" Value="True">
                                                                                    <Setter TargetName="bd" Property="Background" Value="{DynamicResource SurfaceAltBrush}" />
                                                                                    <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                                                                </Trigger>
                                                                            </ControlTemplate.Triggers>
                                                                        </ControlTemplate>
                                                                    </Setter.Value>
                                                                </Setter>
                                                            </Style>
                                                        </ListBox.ItemContainerStyle>
                                                        <ListBox.ItemTemplate>
                                                            <DataTemplate>
                                                                <TextBlock Text="{Binding Text}" Style="{StaticResource Body}"
                                                                           TextWrapping="Wrap" Margin="2,3" />
                                                            </DataTemplate>
                                                        </ListBox.ItemTemplate>
                                                    </ListBox>
                                                    <TextBlock Text="{Binding Feedback}" Style="{StaticResource Muted}"
                                                               Margin="0,6,0,0" Foreground="{DynamicResource AccentBrush}" />
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <StackPanel Orientation="Horizontal">
                                    <Button Content="Enviar respuestas" Style="{StaticResource BtnPrimary}"
                                            Command="{Binding SubmitEvaluationCommand}" />
                                </StackPanel>
                                <TextBlock Text="{Binding EvaluationResult}" Style="{StaticResource H3}" Margin="0,12,0,0"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>

                        <!-- Contenido -->
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="Explicación para principiantes" Style="{StaticResource H3}" />
                                <TextBlock Text="{Binding Explanation}" Style="{StaticResource Body}" MaxWidth="760"
                                           HorizontalAlignment="Left" Margin="0,8,0,0" />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="Conceptos y vocabulario" Style="{StaticResource H3}" />
                                <ItemsControl ItemsSource="{Binding Concepts}" Margin="0,8,0,0">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                                <TextBlock Text="{Binding Term}" FontWeight="SemiBold"
                                                           Foreground="{DynamicResource AccentBrush}" FontSize="13" />
                                                <TextBlock Text="{Binding Definition}" Style="{StaticResource Body}"
                                                           FontSize="13" Margin="8,0,0,0" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="Ejemplo en un entorno laboral" Style="{StaticResource H3}" />
                                <TextBlock Text="{Binding Workplace}" Style="{StaticResource Body}" MaxWidth="760"
                                           HorizontalAlignment="Left" Margin="0,8,0,0" />
                            </StackPanel>
                        </Border>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="16" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Text="Procedimiento paso a paso" Style="{StaticResource H3}" />
                                    <ItemsControl ItemsSource="{Binding Procedure}" Margin="0,8,0,0">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Style="{StaticResource Body}" Text="{Binding}"
                                                           Margin="0,0,0,6" />
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="2" Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Text="Errores frecuentes" Style="{StaticResource H3}" />
                                    <ItemsControl ItemsSource="{Binding Mistakes}" Margin="0,8,0,0">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Style="{StaticResource Body}" Text="{Binding}"
                                                           Foreground="{DynamicResource DangerBrush}"
                                                           Margin="0,0,0,6" />
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="Ejercicio guiado" Style="{StaticResource H3}" />
                                <TextBlock Text="{Binding Guided}" Style="{StaticResource Body}" Margin="0,8,0,0" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="Ejercicio independiente" Style="{StaticResource H3}" />
                                <TextBlock Text="{Binding Independent}" Style="{StaticResource Body}" Margin="0,8,0,0" />
                            </StackPanel>
                        </Border>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="16" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Text="Resumen" Style="{StaticResource H3}" />
                                    <TextBlock Text="{Binding Summary}" Style="{StaticResource Body}" Margin="0,8,0,0" />
                                    <TextBlock Text="Recomendaciones de repaso" Style="{StaticResource H3}" Margin="0,14,0,4" />
                                    <TextBlock Text="{Binding Review}" Style="{StaticResource Body}" />
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="2" Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Text="Criterios de aprobación" Style="{StaticResource H3}" />
                                    <TextBlock Text="{Binding Approval}" Style="{StaticResource Body}" Margin="0,8,0,0" />
                                    <TextBlock Text="Historial de intentos" Style="{StaticResource H3}" Margin="0,14,0,4" />
                                    <ItemsControl ItemsSource="{Binding AttemptHistory}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding}" Style="{StaticResource Muted}" Margin="0,0,0,4" />
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="Referencias complementarias" Style="{StaticResource H3}" />
                                <ItemsControl ItemsSource="{Binding References}" Margin="0,8,0,0">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding}" Style="{StaticResource Muted}" Margin="0,0,0,4" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </DataTemplate>

    <!-- ===================== LABORATORIO ===================== -->
    <DataTemplate DataType="{x:Type vm:LabViewModel}">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource Card}" Padding="10">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="Escenarios" Style="{StaticResource H3}" Margin="8,6,8,10" />
                    <ListBox Style="{StaticResource PlainList}" ItemsSource="{Binding Scenarios}"
                             SelectedItem="{Binding SelectedScenario}">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="2,4">
                                    <TextBlock Text="{Binding Title}" Style="{StaticResource Body}" FontSize="13" />
                                    <TextBlock Text="{Binding DifficultyLabel}" Style="{StaticResource Muted}" FontSize="11" />
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>

            <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto" Padding="0,0,8,20">
                <StackPanel>
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="{Binding Title}" Style="{StaticResource H2}" />
                            <TextBlock Text="{Binding Difficulty}" Style="{StaticResource Muted}" Margin="0,6,0,0"
                                       Foreground="{DynamicResource WarningBrush}" />
                            <TextBlock Text="Contexto" Style="{StaticResource H3}" Margin="0,12,0,4" />
                            <TextBlock Text="{Binding Context}" Style="{StaticResource Body}" MaxWidth="760"
                                       HorizontalAlignment="Left" />
                            <TextBlock Text="Síntomas" Style="{StaticResource H3}" Margin="0,12,0,4" />
                            <ItemsControl ItemsSource="{Binding Symptoms}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding}" Style="{StaticResource Body}" Margin="0,0,0,4" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="Acciones disponibles (simuladas)" Style="{StaticResource H3}" />
                                <ItemsControl ItemsSource="{Binding Actions}" Margin="0,10,0,0">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="{DynamicResource SurfaceAltBrush}" CornerRadius="8"
                                                    Padding="12" Margin="0,0,0,8">
                                                <StackPanel>
                                                    <TextBlock Text="{Binding Label}" Style="{StaticResource Body}"
                                                               FontWeight="SemiBold" />
                                                    <TextBlock Text="{Binding KindLabel}" Style="{StaticResource Muted}"
                                                               FontSize="12" />
                                                    <Button Content="Realizar acción" Style="{StaticResource BtnSecondary}"
                                                            Margin="0,8,0,0"
                                                            Command="{Binding DataContext.ChooseActionCommand,
                                                                     RelativeSource={RelativeSource AncestorType=ContentControl}}"
                                                            CommandParameter="{Binding}" />
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>

                        <StackPanel Grid.Column="2">
                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Text="Evidencias recopiladas" Style="{StaticResource H3}" />
                                    <ItemsControl ItemsSource="{Binding Evidence}" Margin="0,10,0,0">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="0,0,0,6">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="170" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="{Binding Key}" FontWeight="SemiBold" FontSize="13"
                                                               Foreground="{DynamicResource AccentBrush}" />
                                                    <TextBlock Grid.Column="1" Text="{Binding Value}"
                                                               Style="{StaticResource Body}" FontSize="13" />
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Text="Tus decisiones" Style="{StaticResource H3}" />
                                    <ItemsControl ItemsSource="{Binding Decisions}" Margin="0,10,0,0">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <StackPanel Margin="0,0,0,10">
                                                    <TextBlock Text="{Binding Label}" Style="{StaticResource Body}"
                                                               FontWeight="SemiBold" />
                                                    <TextBlock Text="{Binding WeightText}" FontSize="12"
                                                               Foreground="{DynamicResource WarningBrush}" />
                                                    <TextBlock Text="{Binding Feedback}" Style="{StaticResource Muted}" />
                                                </StackPanel>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                        <Button Content="Finalizar caso" Style="{StaticResource BtnPrimary}"
                                                Command="{Binding FinishCommand}" />
                                        <Button Content="Reiniciar" Style="{StaticResource BtnDanger}"
                                                Command="{Binding ResetCommand}" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource MsgInfo}" Visibility="{Binding Finished, Converter={StaticResource BoolToVis}}">
                                <StackPanel>
                                    <TextBlock Text="Resultado del caso" Style="{StaticResource H3}" />
                                    <TextBlock Text="{Binding ResultText}" Style="{StaticResource Body}" Margin="0,8,0,0"
                                               FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding SolutionText}" Style="{StaticResource Body}" Margin="0,8,0,0" />
                                    <TextBlock Text="{Binding EscalationText}" Style="{StaticResource Body}" Margin="0,8,0,0" />
                                    <TextBlock Text="Criterios de evaluación" Style="{StaticResource H3}" Margin="0,12,0,4" />
                                    <ItemsControl ItemsSource="{Binding Criteria}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding}" Style="{StaticResource Muted}" Margin="0,0,0,4" />
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </DataTemplate>

</ResourceDictionary>

<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:vm="clr-namespace:RutaTI30.App.ViewModels">

    <!-- ===================== RUTAS DE ESPECIALIZACIÓN ===================== -->
    <DataTemplate DataType="{x:Type vm:RoutesViewModel}">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="Rutas de especialización (opcionales)" Style="{StaticResource H3}" />
                        <TextBlock Style="{StaticResource Muted}" Margin="0,6,0,0" TextWrapping="Wrap"
                                   Text="Cuando domines los 30 días, puedes profundizar en un área. Estas rutas son opcionales: no necesitas contenido avanzado para tu primer empleo de soporte L1. Cada ruta se apoya en lecciones, escenarios y preguntas de entrevista que ya existen en la aplicación." />
                    </StackPanel>
                </Border>

                <ItemsControl ItemsSource="{Binding Items}" Margin="0,16,0,0">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                                <StackPanel>
                                    <TextBlock Text="{Binding Title}" Style="{StaticResource H3}" />
                                    <TextBlock Text="{Binding Focus}" Style="{StaticResource Body}"
                                               Margin="0,4,0,0" TextWrapping="Wrap" />
                                    <TextBlock Text="Prerrequisitos" Style="{StaticResource Label}" Margin="0,12,0,0" />
                                    <TextBlock Text="{Binding Prerequisites}" Style="{StaticResource Body}"
                                               TextWrapping="Wrap" Margin="0,2,0,0" />
                                    <TextBlock Text="Competencias" Style="{StaticResource Label}" Margin="0,12,0,0" />
                                    <TextBlock Text="{Binding CompetenciesText}" Style="{StaticResource Body}"
                                               TextWrapping="Wrap" Margin="0,2,0,0" />
                                    <TextBlock Text="Lecciones base" Style="{StaticResource Label}" Margin="0,12,0,0" />
                                    <TextBlock Text="{Binding LessonsText}" Style="{StaticResource Body}"
                                               TextWrapping="Wrap" Margin="0,2,0,0" />
                                    <TextBlock Text="Prácticas recomendadas" Style="{StaticResource Label}" Margin="0,12,0,0" />
                                    <TextBlock Text="{Binding PracticesText}" Style="{StaticResource Body}"
                                               TextWrapping="Wrap" Margin="0,2,0,0" />
                                    <TextBlock Text="Áreas del banco de entrevistas" Style="{StaticResource Label}" Margin="0,12,0,0" />
                                    <TextBlock Text="{Binding AreasText}" Style="{StaticResource Body}"
                                               TextWrapping="Wrap" Margin="0,2,0,0" />
                                    <TextBlock Text="Puestos relacionados" Style="{StaticResource Label}" Margin="0,12,0,0" />
                                    <TextBlock Text="{Binding EntryRoles}" Style="{StaticResource Muted}"
                                               TextWrapping="Wrap" Margin="0,2,0,0" />
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>
    </DataTemplate>
</ResourceDictionary>

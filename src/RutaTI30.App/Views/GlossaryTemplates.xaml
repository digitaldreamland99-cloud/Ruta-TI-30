<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:vm="clr-namespace:RutaTI30.App.ViewModels">

    <!-- ===================== GLOSARIO ===================== -->
    <DataTemplate DataType="{x:Type vm:GlossaryViewModel}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Buscador -->
            <Border Grid.Row="0" Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="Glosario de conceptos" Style="{StaticResource H3}" />
                    <TextBlock Style="{StaticResource Muted}" Margin="0,4,0,0" TextWrapping="Wrap"
                               Text="Consulta sin conexión: definición sencilla, explicación técnica, ejemplo laboral y error frecuente, enlazados con las lecciones del programa." />
                    <Grid Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0" Style="{StaticResource Field}"
                                 Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="Busca por concepto, definición o ejemplo (por ejemplo: DNS, ticket, contraseña)" />
                        <ComboBox Grid.Column="2" MinWidth="200" VerticalAlignment="Center"
                                  ItemsSource="{Binding Categories}"
                                  SelectedItem="{Binding SelectedCategory}"
                                  ToolTip="Filtra por categoría" />
                        <Button Grid.Column="4" Content="Limpiar" Style="{StaticResource BtnSecondary}"
                                Command="{Binding ClearSearchCommand}" VerticalAlignment="Center" />
                    </Grid>
                    <TextBlock Text="{Binding ResultSummary}" Style="{StaticResource Muted}" Margin="0,8,0,0" />
                </StackPanel>
            </Border>

            <!-- Resultado + detalle -->
            <Grid Grid.Row="1" Margin="0,16,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="340" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource Card}" Padding="10" VerticalAlignment="Stretch">
                    <ListBox Style="{StaticResource PlainList}" ItemsSource="{Binding Items}"
                             SelectedItem="{Binding SelectedItem}"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             VirtualizingPanel.IsVirtualizing="True">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="2,4">
                                    <TextBlock Text="{Binding Term}" FontWeight="SemiBold" FontSize="13"
                                               TextWrapping="Wrap" />
                                    <TextBlock Text="{Binding Category}" FontSize="11" Style="{StaticResource Muted}" />
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Border>

                <Border Grid.Column="2" Style="{StaticResource Card}" VerticalAlignment="Stretch">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <TextBlock Text="{Binding SelectedItem.Term}" Style="{StaticResource H2}"
                                       TextWrapping="Wrap" />
                            <TextBlock Text="{Binding SelectedItem.Category}" Style="{StaticResource Muted}"
                                       Margin="0,4,0,0" />
                            <TextBlock Text="Definición sencilla" Style="{StaticResource Label}" Margin="0,14,0,0" />
                            <TextBlock Text="{Binding SelectedItem.SimpleDefinition}" Style="{StaticResource Body}"
                                       TextWrapping="Wrap" MaxWidth="760" HorizontalAlignment="Left" Margin="0,2,0,0" />
                            <TextBlock Text="Explicación técnica" Style="{StaticResource Label}" Margin="0,14,0,0" />
                            <TextBlock Text="{Binding SelectedItem.TechnicalExplanation}" Style="{StaticResource Body}"
                                       TextWrapping="Wrap" MaxWidth="760" HorizontalAlignment="Left" Margin="0,2,0,0" />
                            <TextBlock Text="Ejemplo laboral" Style="{StaticResource Label}" Margin="0,14,0,0" />
                            <TextBlock Text="{Binding SelectedItem.WorkplaceExample}" Style="{StaticResource Body}"
                                       TextWrapping="Wrap" MaxWidth="760" HorizontalAlignment="Left" Margin="0,2,0,0" />
                            <TextBlock Text="Error frecuente" Style="{StaticResource Label}" Margin="0,14,0,0" />
                            <TextBlock Text="{Binding SelectedItem.CommonMistake}"
                                       Foreground="{DynamicResource WarningBrush}"
                                       TextWrapping="Wrap" Margin="0,2,0,0" />
                            <TextBlock Text="{Binding SelectedItem.RelatedText}" Style="{StaticResource Muted}"
                                       Margin="0,14,0,0" TextWrapping="Wrap" />
                        </StackPanel>
                    </ScrollViewer>
                </Border>
            </Grid>
        </Grid>
    </DataTemplate>
</ResourceDictionary>
